# App
APP_NAME=CineLock
APP_ENV=development
DEBUG=true
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000

# CORS (frontend origin)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# TMDB
TMDB_API_KEY=your-tmdb-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# Geoapify location search and cinema geocoding
GEOAPIFY_API_KEY=your-geoapify-api-key

# YouPI-PG signed reconciliation webhook secret (keep private; never expose to Vite).
YOUPI_WEBHOOK_SECRET=your-youpi-webhook-secret

# File Storage
DATA_DIR=./data

# Seat Locking
SEAT_LOCK_TTL_MINUTES=5
SEAT_LOCK_CLEANUP_INTERVAL_SECONDS=60
